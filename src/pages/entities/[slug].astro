---
import BaseLayout from '../../layouts/BaseLayout.astro';
import entitiesData from '../../data/entities.json';

// 1. Generate a page for every item in the JSON
export async function getStaticPaths() {
  return entitiesData.map((entity) => {
    // Dynamically create a URL-friendly slug (e.g., "West African Griot" -> "west-african-griot")
    const slug = entity.name.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)+/g, '');
    
    return {
      params: { slug },
      props: { entity },
    };
  });
}

// 2. Extract the specific entity data for the current page
const { entity } = Astro.props;
---

<BaseLayout 
  title={entity.name} 
  description={`Historical archive entry for ${entity.name}`}
>
  <div class="mt-8">
    <a href="/hip-hop-continuum/" class="text-blue-400 hover:text-blue-300 text-sm mb-6 inline-block tracking-widest uppercase">&larr; Back to Continuum</a>
    
    <article class="bg-gray-800 p-8 rounded-lg border border-gray-700 shadow-md">
      <div class="flex flex-col md:flex-row md:items-center gap-4 mb-6">
        <h2 class="text-3xl font-extrabold text-white">{entity.name}</h2>
        {entity.type && (
          <span class="px-3 py-1 bg-blue-900/50 border border-blue-700 text-blue-300 text-xs font-bold uppercase tracking-wider rounded-full w-fit">
            {entity.type}
          </span>
        )}
      </div>
      
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mt-6 border-t border-gray-700 pt-6">
        <div class="md:col-span-2">
          <h3 class="text-lg font-bold text-gray-300 mb-3">Historical Context</h3>
          <p class="text-gray-200 leading-relaxed whitespace-pre-line">
            {entity.description || "Historical documentation pending."}
          </p>
        </div>
        
        <aside class="bg-gray-900 p-5 rounded-lg border border-gray-700 h-fit">
          <h3 class="text-sm font-bold text-gray-400 mb-4 border-b border-gray-800 pb-2 uppercase tracking-wider">Archive Data</h3>
          <ul class="text-sm space-y-4">
            {entity.origin && (
              <li>
                <strong class="block text-gray-500 mb-1">Origin / Location</strong> 
                <span class="text-gray-300">{entity.origin}</span>
              </li>
            )}
            {entity.era && (
              <li>
                <strong class="block text-gray-500 mb-1">Era</strong> 
                <span class="text-gray-300">{entity.era}</span>
              </li>
            )}
          </ul>
        </aside>
      </div>
    </article>
  </div>
</BaseLayout>