---
import BaseLayout from '../../layouts/BaseLayout.astro';
import entitiesData from '../../data/entities.json';
import TimelineMap from '../../components/TimelineMap.astro';
import LineageFlow from '../../components/LineageFlow.astro';

const generateSlug = (name: string) => {
  return name.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)+/g, '');
};
---

<BaseLayout title="The Historical Continuum of Hip Hop" description="A living cultural genealogy mapping Pan-African oral traditions and technological evolution.">
  
  <section class="mb-16">
    <h2 class="text-2xl font-bold text-white mb-4">Root Traditions vs. The Single-Origin Narrative</h2>
    <p class="text-gray-300 leading-relaxed mb-4">
      Hip Hop as a continuum, not a single point of origin. Trace recurring techniques, traditions, places, and relationships across time. The archive distinguishes documented history from interpretive connections so the map can grow without flattening the evidence.
    </p>
  </section>

  <!-- Interactive Lineage Flowchart -->
  <section class="mb-16">
    <LineageFlow />
  </section>

  <!-- Dynamic Archive Entities List -->
  <section class="mb-16">
    <h2 class="text-2xl font-bold text-white mb-6">The Continuum Archive</h2>
    <div class="grid grid-cols-1 gap-6">
      {entitiesData.map((entity, index) => (
        <a 
          href={`/hip-hop-continuum/entities/${generateSlug(entity.name)}`}
          class="block bg-gray-800 p-6 rounded-lg border border-gray-700 hover:border-blue-500 hover:bg-gray-750 transition-all group"
        >
          <div class="flex flex-col md:flex-row md:items-center justify-between mb-3">
            <span class="text-xs font-bold text-blue-400 tracking-wider uppercase">
              0{index + 1} — {entity.era}
            </span>
            {entity.type && (
              <span class="px-2.5 py-0.5 bg-blue-900/40 border border-blue-700 text-blue-300 text-[10px] font-bold uppercase tracking-wider rounded-full w-fit mt-1 md:mt-0">
                {entity.type}
              </span>
            )}
          </div>
          
          <h3 class="text-xl font-bold text-white group-hover:text-blue-300 transition-colors mb-2">
            {entity.name}
          </h3>
          
          <p class="text-sm text-gray-400 line-clamp-2 mb-4">
            {entity.description}
          </p>

          {entity.origin && (
            <div class="text-xs text-gray-500 flex items-center gap-1">
              <strong class="text-gray-400">Origin:</strong> {entity.origin}
            </div>
          )}
        </a>
      ))}
    </div>
  </section>

  <!-- Ancestral Timeline Section -->
  <section class="mb-16">
    <h2 class="text-2xl font-bold text-white mb-6">Ancestral Timeline</h2>
    <TimelineMap />
  </section>

</BaseLayout>