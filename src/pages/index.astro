---
import BaseLayout from '../layouts/BaseLayout.astro';
import TimelineMap from '../components/TimelineMap.astro';
import LineageFlow from '../components/LineageFlow.astro';
---

<BaseLayout 
  title="The Historical Continuum of Hip Hop" 
  description="Root Traditions vs. The Single-Origin Narrative"
>
  <main class="grid grid-cols-1 md:grid-cols-3 gap-12">
    <section class="md:col-span-2">
      <h2 class="text-2xl font-bold text-white mb-4">Ancestral Timeline</h2>
      <TimelineMap />
      
      <LineageFlow />
    </section>
    
    <aside class="bg-gray-800 p-6 rounded-lg h-fit border border-gray-700">
      <h3 class="text-lg font-bold text-white mb-3">About the Archive</h3>
      <p class="text-sm text-gray-300">
        A living document mapping the centuries-long evolutionary continuum of oral expression, rhythmic innovation, and social commentary across the African diaspora.
      </p>
    </aside>
  </main>
</BaseLayout>