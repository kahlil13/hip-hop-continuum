---
import BaseLayout from '../layouts/BaseLayout.astro';
import TimelineMap from '../components/TimelineMap.astro';
import LineageFlow from '../components/LineageFlow.astro';
import Continuum from '../components/Continuum.astro';
---

<BaseLayout
  title="The Historical Continuum of Hip Hop"
  description="Root Traditions vs. The Single-Origin Narrative"
>
  <main>
    <section class="grid grid-cols-1 gap-12 md:grid-cols-3">
      <div class="md:col-span-2">
        <p class="mb-3 text-xs uppercase tracking-[0.3em] text-blue-400">A living cultural genealogy</p>
        <h1 class="text-4xl font-bold tracking-tight text-white md:text-5xl">
          Hip Hop as a continuum, not a single point of origin.
        </h1>
        <p class="mt-5 max-w-3xl text-base leading-7 text-gray-300">
          Trace recurring techniques, traditions, places, and relationships across time. The archive distinguishes documented history from interpretive connections so the map can grow without flattening the evidence.
        </p>
      </div>

      <aside class="rounded-xl border border-gray-700 bg-gray-800 p-6">
        <p class="text-xs uppercase tracking-wider text-gray-500">Archive principle</p>
        <h2 class="mt-2 text-lg font-bold text-white">Connections need evidence.</h2>
        <p class="mt-3 text-sm leading-6 text-gray-300">
          A shared technique does not automatically prove direct transmission. Each relationship can carry its own status and research note.
        </p>
      </aside>
    </section>

    <Continuum />

    <section class="mt-16 grid grid-cols-1 gap-12 md:grid-cols-2">
      <div>
        <h2 class="mb-4 text-2xl font-bold text-white">Ancestral Timeline</h2>
        <TimelineMap />
      </div>
      <div>
        <LineageFlow />
      </div>
    </section>
  </main>
</BaseLayout>