---
import traditions from '../../data/traditions.json';
import techniques from '../../data/techniques.json';
import relationships from '../../data/relationships.json';

const techniqueMap = new Map(techniques.map((item) => [item.id, item]));
const traditionMap = new Map(traditions.map((item) => [item.id, item]));

const outgoing = new Map<string, typeof relationships>();
for (const relationship of relationships) {
  const list = outgoing.get(relationship.source) ?? [];
  list.push(relationship);
  outgoing.set(relationship.source, list);
}
---

<section class="mt-12">
  <div class="mb-6 flex items-end justify-between gap-4">
    <div>
      <p class="text-xs uppercase tracking-[0.25em] text-blue-400">Relationship map</p>
      <h2 class="mt-2 text-2xl font-bold text-white">The Continuum</h2>
    </div>
    <p class="max-w-md text-sm text-gray-400">
      Explore traditions through shared techniques and documented or interpretive relationships.
    </p>
  </div>

  <div class="space-y-4">
    {traditions.map((tradition, index) => (
      <article class="rounded-xl border border-gray-700 bg-gray-800/80 p-5">
        <div class="flex flex-col gap-4 md:flex-row md:items-start md:justify-between">
          <div class="max-w-2xl">
            <div class="flex items-center gap-3">
              <span class="text-xs font-mono text-gray-500">{String(index + 1).padStart(2, '0')}</span>
              <h3 class="text-xl font-semibold text-white">{tradition.name}</h3>
            </div>
            <p class="mt-2 text-sm leading-6 text-gray-300">{tradition.description}</p>

            <div class="mt-4 flex flex-wrap gap-2">
              {tradition.techniques.map((id) => {
                const technique = techniqueMap.get(id);
                return technique ? (
                  <span class="rounded-full border border-gray-600 px-2.5 py-1 text-xs text-gray-300">
                    {technique.name}
                  </span>
                ) : null;
              })}
            </div>
          </div>

          <div class="w-full shrink-0 md:w-64">
            <p class="text-xs uppercase tracking-wider text-gray-500">Continuity</p>
            {outgoing.get(tradition.id)?.length ? (
              <div class="mt-2 space-y-2">
                {outgoing.get(tradition.id)?.map((relationship) => {
                  const target = traditionMap.get(relationship.target);
                  return target ? (
                    <div class="rounded-lg border border-gray-700 bg-gray-900/60 p-3">
                      <div class="text-sm font-medium text-blue-300">→ {target.name}</div>
                      <div class="mt-1 text-xs text-gray-500">{relationship.status}</div>
                    </div>
                  ) : null;
                })}
              </div>
            ) : (
              <p class="mt-2 text-sm text-gray-500">No outgoing relationship recorded.</p>
            )}
          </div>
        </div>
      </article>
    ))}
  </div>
</section>